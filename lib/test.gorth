# primitive types
# 42 DUMP
# 3.14 DUMP
# "Hello, Gorth!" DUMP
# TRUE DUMP
# FALSE DUMP
# [1, 2, 3] DUMP

# basic math
# 2 3 +
# 2 3 *
# 2 3 /
# 2 3 -
# 2 3 ^
# 2 3 %
# 2 3 MAX
# 2 3 MIN

# logical operations
# TRUE TRUE &&
# TRUE FALSE ||

# comparison operations
# 2 3 <
# 2 3 >
# 2 3 <=
# 2 3 >=
# 2 3 ==
# 2 3 !=

# variable assignment
# 42 := VAR answer
# answer DUMP
#
# OR you can also declare then assign
#
# VAR answer
# 42 := answer
# answer DUMP

# constant declaration
# CONST PI 3.14
# PI DUMP

# while loop
0 := VAR count

DO
    count INC := count
    DO
        "Count has reached " count + DUMPLN
        BREAK
    ELSE
        "Count has not reached " count + " yet" + DUMPLN
        CONTINUE
    IF
        count 5 ==
    END
WHILE
    count 10 <
END

