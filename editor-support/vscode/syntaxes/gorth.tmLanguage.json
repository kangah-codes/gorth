{
	"name": "Gorth",
	"scopeName": "source.gorth",
	"fileTypes": ["gorth"],
	"patterns": [
		{ "include": "#comments" },
		{ "include": "#strings" },
		{ "include": "#numbers" },
		{ "include": "#keywords" },
		{ "include": "#booleans" },
		{ "include": "#null" },
		{ "include": "#operators" },
		{ "include": "#stack-operations" },
		{ "include": "#io-operations" },
		{ "include": "#arrays" },
		{ "include": "#identifiers" }
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.line.number-sign.gorth",
					"match": "#.*$"
				}
			]
		},
		"strings": {
			"patterns": [
				{
					"name": "string.quoted.double.gorth",
					"begin": "\"",
					"end": "\"",
					"patterns": [
						{
							"name": "constant.character.escape.gorth",
							"match": "\\\\."
						}
					]
				}
			]
		},
		"numbers": {
			"patterns": [
				{
					"name": "constant.numeric.float.gorth",
					"match": "\\b\\d+\\.\\d+\\b"
				},
				{
					"name": "constant.numeric.integer.gorth",
					"match": "\\b\\d+\\b"
				}
			]
		},
		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.gorth",
					"match": "\\b(CONST|VAR|IF|ELSE|END|WHILE|DO)\\b"
				}
			]
		},
		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.arithmetic.gorth",
					"match": "[+\\-*/%^]"
				},
				{
					"name": "keyword.operator.comparison.gorth",
					"match": "(==|!=|>=|<=|>|<)"
				},
				{
					"name": "keyword.operator.logical.gorth",
					"match": "(&&|\\|\\||!)"
				},
				{
					"name": "keyword.operator.assignment.gorth",
					"match": "(:=|=)"
				}
			]
		},
		"stack-operations": {
			"patterns": [
				{
					"name": "keyword.other.stack.gorth",
					"match": "\\b(DROP|SWAP|DUP|OVER|ROT|DEL|INC|DEC|CLEAR|PICK)\\b"
				}
			]
		},
		"io-operations": {
			"patterns": [
				{
					"name": "keyword.other.io.gorth",
					"match": "\\b(DUMP|DUMPLN)\\b"
				}
			]
		},
		"identifiers": {
			"patterns": [
				{
					"name": "variable.other.gorth",
					"match": "\\b[A-Za-z][A-Za-z0-9]*\\b"
				}
			]
		},
		"booleans": {
			"patterns": [
				{
					"name": "constant.language.boolean.gorth",
					"match": "\\b(TRUE|FALSE)\\b"
				}
			]
		},
		"null": {
			"patterns": [
				{
					"name": "constant.language.null.gorth",
					"match": "\\bNULL\\b"
				}
			]
		},
		"arrays": {
			"patterns": [
				{
					"name": "meta.brackets.gorth",
					"begin": "\\[",
					"end": "\\]",
					"patterns": [
						{ "include": "#strings" },
						{ "include": "#numbers" },
						{ "include": "#booleans" },
						{ "include": "#null" },
						{ "include": "#identifiers" },
						{
							"name": "punctuation.separator.comma.gorth",
							"match": ","
						}
					]
				}
			]
		}
	}
}
