{
  "name": "gorth-language-support",
  "displayName": "Gorth Language Support",
  "description": "Syntax highlighting and language support for Gorth",
  "version": "0.1.0",
  "publisher": "kangah-codes",
  "repository": {
    "type": "git",
    "url": "https://github.com/kangah-codes/gorth"
  },
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "gorth",
        "aliases": [
          "Gorth",
          "gorth"
        ],
        "extensions": [
          ".gorth"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "gorth",
        "scopeName": "source.gorth",
        "path": "./syntaxes/gorth.tmLanguage.json"
      }
    ]
  }
}
