{
  "name": "Gorth",
  "scopeName": "source.gorth",
  "fileTypes": ["gorth"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#stack-operations" },
    { "include": "#io-operations" },
    { "include": "#variables" },
    { "include": "#booleans" },
    { "include": "#arrays" },
    { "include": "#pointers" }
  ],
  "repository": {
    "comments": {
      "patterns": [{
        "name": "comment.line.number-sign.gorth",
        "match": "#.*$"
      }]
    },
    "strings": {
      "patterns": [{
        "name": "string.quoted.double.gorth",
        "begin": "\"",
        "end": "\"",
        "patterns": [{
          "name": "constant.character.escape.gorth",
          "match": "\\\\."
        }]
      }]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.gorth",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.gorth",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [{
        "name": "keyword.control.gorth",
        "match": "\\b(const|proc|endproc|in|return)\\b"
      }]
    },
    "types": {
      "patterns": [{
        "name": "storage.type.gorth",
        "match": "\\b(int|str|bool|float|ptr|arr)\\b"
      }]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.gorth",
          "match": "[+\\-*/%^]"
        },
        {
          "name": "keyword.operator.comparison.gorth",
          "match": "(==|!=|>=?|<=?)"
        },
        {
          "name": "keyword.operator.logical.gorth",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.assignment.gorth",
          "match": "="
        }
      ]
    },
    "stack-operations": {
      "patterns": [{
        "name": "keyword.other.stack.gorth",
        "match": "\\b(drop|swap|dup|over|rot|del|inc|dec)\\b"
      }]
    },
    "io-operations": {
      "patterns": [{
        "name": "keyword.other.io.gorth",
        "match": "\\b(print|println|dump)\\b"
      }]
    },
    "variables": {
      "patterns": [{
        "name": "variable.other.gorth",
        "match": "\\$[a-zA-Z][a-zA-Z0-9_]*"
      }]
    },
    "booleans": {
      "patterns": [{
        "name": "constant.language.boolean.gorth",
        "match": "\\b(true|false)\\b"
      }]
    },
    "arrays": {
      "patterns": [
        {
          "name": "meta.brackets.gorth",
          "begin": "\\[",
          "end": "\\]",
          "patterns": [
            { "include": "#strings" },
            { "include": "#numbers" },
            { "include": "#variables" },
            { "include": "#booleans" },
            {
              "name": "punctuation.separator.comma.gorth",
              "match": ","
            }
          ]
        }
      ]
    },
    "pointers": {
      "patterns": [
        {
          "name": "keyword.operator.pointer.gorth",
          "match": "@"
        },
        {
          "name": "storage.modifier.pointer.gorth",
          "match": "\\*\\d+"
        }
      ]
    }
  }
}
